{
    "name": "@jdrly/prettier-plugin-hubl",
    "version": "1.0.2",
    "description": "Prettier plugin for HubL (HubSpot templating language) formatting in HTML, CSS, JSX, and TSX files",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest",
        "test:run": "vitest run",
        "lint": "eslint src --ext .ts --fix",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "prettier",
        "plugin",
        "hubl",
        "hubspot",
        "formatter",
        "html",
        "css",
        "jsx",
        "tsx"
    ],
    "author": "jd",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/jdrly/prettier_hubl_plugin"
    },
    "peerDependencies": {
        "prettier": "^3.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "prettier": "^3.2.0",
        "typescript": "^5.3.0",
        "vitest": "^1.2.0",
        "eslint": "^8.56.0",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0"
    },
    "dependencies": {
        "lodash-es": "^4.17.21"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
